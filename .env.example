DATABRICKS_HOST=https://...
PGDATABASE=your_postgres_databaseName
LAKEBASE_ENDPOINT=your_postgres_endpointPath
PGHOST=your_postgres_host
PGPORT=5432
PGSSLMODE=require
MODEL_SERVICE=your_catalog.your_schema.your_model_service
# Never set DEMO_BOOTSTRAP here: only the deployed app (its service principal) may create the
# replen_agent_hub schema. It lives in app.yaml.
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=replenishment-agent-hub
